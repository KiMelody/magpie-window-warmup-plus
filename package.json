{
  "name": "magpie-window-warmup-plus",
  "version": "0.2.0",
  "description": "窗口预热增强版：按目标使用时刻倒推开窗、自定义打招呼消息、发送后读 magpie 内置额度卡验证窗口是否真的开启/刷新。Forked from @magpie-community/page-window-warmup.",
  "author": "magpie-window-warmup-plus",
  "type": "module",
  "license": "MIT",
  "main": "dist/plugin.js",
  "files": [
    "dist",
    "page",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "magpie": ">=0.1.1340",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "magpie": {
    "page": {
      "title": "Window Warmup",
      "titles": {
        "zh": "窗口预热",
        "zh-TW": "窗口預熱",
        "ja": "ウィンドウ予熱"
      },
      "file": "page/index.html",
      "service": {
        "port": 3492,
        "option": "port"
      },
      "icon": "page/icon.svg"
    },
    "options": {
      "port": 3492
    },
    "permissions": [],
    "icon": "data:image/svg+xml;base64,"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiMelody/magpie-window-warmup-plus.git"
  },
  "homepage": "https://github.com/KiMelody/magpie-window-warmup-plus",
  "bugs": "https://github.com/KiMelody/magpie-window-warmup-plus/issues",
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "llm",
    "window-warmup",
    "cron",
    "quota",
    "warmup",
    "keep-alive",
    "schedule",
    "rate-limit"
  ]
}
